# ===== WebUI 访问端口 =====
WEBUI_PORT=8080

# ===== noVNC 网页远程桌面端口（容器→宿主映射） =====
NOVNC_PORT=6080
VNC_PORT=5900

# ===== WebUI 登录账号（容器环境变量）=====
# WEBUI_PASSWORD 留空 = 首次启动自动生成随机 admin 密码并打印到容器日志
# （docker compose logs agent），登录后到「设置 → 账号安全」改密。建议直接填强密码。
WEBUI_USERNAME=admin
WEBUI_PASSWORD=

# ===== 安全：noVNC/VNC 连接密码（初始密码，生产请务必改为强密码！） =====
# 部署后推荐登录 WebUI →「设置 → 远程桌面密码」查看/修改：改完立即生效、容器重启后
# 保留；WebUI 保存过密码后本项仅作兜底，不再覆盖用户设置。
VNC_PASSWORD=change-me-1234

# ===== 浏览器资源模型（内存治理，一般无需改） =====
# 同一时刻最多存活几个账号浏览器实例。每个有头 Chromium 约 450-500MB，
# 2GB 小内存机器请保持 1（严格串行：任务按平台顺序执行时自动切换浏览器，
# 登录态各自落盘不丢失）。<=0 表示不限制。
BROWSER_MAX_INSTANCES=1
# 浏览器闲置多少秒后自动回收（省内存）。任务/面板每使用一次会自动续租。
BROWSER_IDLE_TTL=900
# 「远程桌面接管」中的账号窗口保留多久不被淘汰/回收（默认 2 小时），超时自动解除。
BROWSER_PIN_TTL=7200

# ===== LLM / 生图（可留空：无 Key 时走离线/测试模式） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FAL_KEY=
STABILITY_API_KEY=

# ===== 拟人行为层（发布反脚本误判，默认开启） =====
# 0=关闭（排查问题时用：退化为最小快捷动作）；1=开启。
# 开启后发布前会先随机浏览/游走/悬停再进发布页，鼠标轨迹为生物力学曲线、
# 键入为脉冲串+思考停顿，mousemove 间隔重尾高熵——更像真人但会拉长单次任务。
HUMANIZER_ENABLED=1

# ===== 杂项 =====
TZ=Asia/Shanghai
LOG_LEVEL=INFO
